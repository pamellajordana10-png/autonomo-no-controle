# AUTONOMO NO CONTROLE - variaveis de ambiente da Vercel
# Vercel > seu projeto > Settings > Environment Variables
# NUNCA suba valores reais para o GitHub: este arquivo e so o modelo.

# Secret do webhook da Cakto - o MESMO valor salvo no painel da Cakto
# e nas Configuracoes comerciais do Admin. Sem ele, o webhook recusa tudo.
CAKTO_WEBHOOK_SECRET=

# Banco externo (Supabase): URL do projeto e chave service_role.
# A service_role fica SO no servidor (variavel da Vercel), nunca no site.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Checkout oficial da Cakto e preco fixo do produto (em centavos)
CHECKOUT_URL=https://pay.cakto.com.br/9s9wjh3_1358656
PRICE_CENTS=3700
